/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for personal data and allows company-level access to company information.
 *
 * Data Structure:
 * - /companies/{companyId}: Stores company-level information, accessible with company ID.
 * - /companies/{companyId}/workCenters/{workCenterId}: Stores work centers for specific companies.
 * - /users/{userId}: Stores user profiles, accessible only by the user themselves.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records for each user, accessible only by the user.
 *
 * Key Security Decisions:
 * - User data is strictly private and accessible only to the authenticated user.
 * - Company data is accessible to company members (not yet fully implemented in this version).
 * - Listing of users and attendance records is allowed only for the owner.
 * - Denormalization is used to simplify security rules and avoid costly `get()` operations.  Specifically, user documents include their `companyId`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Defines a function to check if the current user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Defines a function to check if the current user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Defines a function to check if the current user is the owner of the resource and it already exists.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /companies/{companyId} collection.
     * @path /companies/{companyId}
     * @allow (get) - Any signed-in user can get a company document.
     * @allow (create) - No one can create a company document (handled by backend).
     * @deny (update) - No one can update a company document (handled by backend).
     * @deny (delete) - No one can delete a company document (handled by backend).
     * @principle Allows read access to company information.
     */
    match /companies/{companyId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /companies/{companyId}/workCenters/{workCenterId} collection.
     * @path /companies/{companyId}/workCenters/{workCenterId}
     * @allow (get) - Any signed-in user can get a workCenter document.
     * @allow (create) - No one can create a workCenter document (handled by backend).
     * @deny (update) - No one can update a workCenter document (handled by backend).
     * @deny (delete) - No one can delete a workCenter document (handled by backend).
     * @principle Allows read access to workCenter information.
     */
    match /companies/{companyId}/workCenters/{workCenterId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (get) - Only the user themselves can read their own profile.
     * @allow (create) - A user can create their own profile (self-registration). The 'id' must match their auth UID.
     * @allow (update) - Only the user themselves can update their profile.
     * @allow (delete) - Only the user themselves can delete their profile.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/attendanceRecords/{attendanceRecordId} collection.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (get) - Only the user themselves can read their own attendance records.
     * @allow (create) - Only the user themselves can create their own attendance records.
     * @deny (update) - Only the user themselves can update their own attendance records.
     * @deny (delete) - Only the user themselves can delete their own attendance records.
     * @principle Enforces user-ownership for attendance records.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}