/**
 * @fileoverview Firestore Security Rules for AttendWise.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * and uses denormalized role information for company-wide access control.
 * Global admin privileges are granted based on document existence in `/roles_admin/{userId}`.
 *
 * Data Structure:
 * - /companies/{companyId}: Stores company profile information.
 * - /users/{userId}: Stores user profile information, including denormalized companyId and role.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records for a specific user.
 * - /roles_admin/{userId}: Indicates global administrator privileges. Document existence grants admin privileges.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user documents and attendance records.
 * - Company data is not directly editable through the rules, but its structure is defined.
 * - Global administrators (defined by document presence in /roles_admin/{userId}) have full access to all data.
 * - Listing all users or attendance records is generally disallowed except for global admins.
 *
 * Denormalization for Authorization:
 * - The 'companyId' is denormalized into the /users/{userId} document to avoid 'get()' calls when authorizing access to company-specific data.
 *
 * Structural Segregation:
 * - Global admin roles are segregated into the /roles_admin/{userId} collection to efficiently determine administrative privileges.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is a global administrator by verifying the existence of a document in `/roles_admin/{userId}`.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the user is the owner of the existing resource.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /companies/{companyId} collection.
     * @path /companies/{companyId}
     * @allow (get) If the user is authenticated.
     * @deny (create, update, delete) Always. Companies are created and managed through other mechanisms (e.g., a dedicated admin interface or backend functions), not directly by end-users.
     * @principle Read access is public, but writes are restricted.
     */
    match /companies/{companyId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) If the user is creating their own document (userId matches auth.uid).
     * @allow (get, update, delete) If the user is the owner of the document or is an admin.
     * @deny (list) Always. Listing users is disallowed.
     * @principle Enforces document ownership for writes, allows owner and admin reads/writes, and prohibits listing.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for the /users/{userId}/attendanceRecords/{attendanceRecordId} collection.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (get, list, create, update, delete) If the user is the owner of the parent user document or is an admin.
     * @deny If the user is not the owner or an admin.
     * @principle Enforces document ownership for writes, and restricts listing.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

        /**
     * @description Rules for the /roles_admin/{userId} collection.
     * @path /roles_admin/{userId}
     * @allow (get, create, update, delete) If the user is an admin. This collection is only intended to be managed by backend processes or highly privileged admins.
     * @deny (list) Always.  We do not want to expose the list of admins.
     * @principle Only admins can create/manage admin roles.
     */
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}