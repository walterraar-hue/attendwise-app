/**
 * @fileoverview Firestore Security Rules for AttendWise.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data and uses
 * denormalization and dedicated collections for authorization independence and
 * role management. This allows for simple and performant security rules without
 * complex queries.
 *
 * Data Structure:
 * - /companies/{companyId}: Stores company profiles.
 * - /users/{userId}: Stores user profiles, including a denormalized companyId for
 *   authorization.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records
 *   for each user.
 * - /roles_admin/{userId}: Indicates global admin status via document existence.
 *
 * Key Security Decisions:
 * - User listing is not directly supported via `list` operations. Collection group
 *   queries or subcollection listing must be used instead.
 * - Global admin privileges are granted based on the existence of a document in
 *   the `/roles_admin/{userId}` collection.
 * - All write operations are protected by authorization checks.
 * - Data validation during writes is limited to relational integrity and consistency
 *   between document IDs and data fields.
 *
 * Denormalization for Authorization:
 * The `companyId` is denormalized into the `/users/{userId}` document to avoid
 * costly `get()` calls when validating user roles and company associations.
 *
 * Structural Segregation:
 * Global admin roles are stored in a separate `/roles_admin` collection to simplify
 * security rules and ensure that all documents in the collection have the same
 * security posture.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read and write access to company profiles based on user role.
     * @path /companies/{companyId}
     * @allow get, list: if true;
     * @allow create: if request.auth.uid != null; // TODO: Add better authorization check here
     * @allow update: if request.auth.uid != null; // TODO: Add better authorization check here
     * @allow delete: if false;
     * @principle Public read, restricted writes with ownership validation.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Manages user profiles. Only the user themselves or a global admin can read/write their profile.
     * @path /users/{userId}
     * @allow get: if isOwner(userId) || isAdmin();
     * @allow list: if false;
     * @allow create: if isSelfCreate(userId);
     * @allow update: if isExistingOwner(userId) || isAdmin();
     * @allow delete: if isExistingOwner(userId) || isAdmin();
     * @deny create: if !isSelfCreate(userId);
     * @principle Enforces document ownership for writes and restricts reads to owner or admin.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isSelfCreate(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Manages attendance records for a user. Only the user or a global admin can manage their attendance records.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow get: if isOwner(userId) || isAdmin();
     * @allow list: if isOwner(userId) || isAdmin();
     * @allow create: if isOwner(userId);
     * @allow update: if isExistingOwner(userId) || isAdmin();
     * @allow delete: if isExistingOwner(userId) || isAdmin();
     * @principle Enforces document ownership for writes and restricts reads to owner or admin.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Grants global admin privileges to a user based on the existence of a document with their ID.
     * @path /roles_admin/{userId}
     * @allow get: if isAdmin();
     * @allow list: if false;
     * @allow create: if isSignedIn(); // TODO: Restrict creation to authorized service accounts.
     * @allow update: if false;
     * @allow delete: if isAdmin();
     * @principle Role management via document existence in a dedicated collection.
     */
    match /roles_admin/{userId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isSignedIn();  //TODO: Restrict to authorized service accounts.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- Helper Functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

     /**
      * @description Checks if the request is attempting to create a user document with the request.auth.uid that matches the document ID.
      * @param {string} userId - The user ID to check against.
      * @return {bool} True if the request.auth.uid is creating a user document with its ID, false otherwise.
      */
    function isSelfCreate(userId) {
      return isSignedIn() && request.auth.uid == userId && request.resource.data.id == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the document.
     * @param {string} userId - The user ID to check against.
     * @return {bool} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is a global administrator.
     * @return {bool} True if the user is a global administrator, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}