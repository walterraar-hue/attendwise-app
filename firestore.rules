rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to company information based on admin privileges or user association.
     * @path /companies/{companyId}
     * @allow (get) If the user is a global admin.
     * @deny (get) If the user is not authenticated.
     * @allow (create) If the user is a global admin.
     * @deny (create) If the user is not authenticated.
     * @allow (update) If the user is a global admin.
     * @deny (update) If the user is not authenticated.
     * @allow (delete) If the user is a global admin.
     * @deny (delete) If the user is not authenticated.
     * @principle Enforces role-based access control for company data.
     */
    match /companies/{companyId} {
      allow get, list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Manages user profiles, enforcing ownership and admin access.
     * @path /users/{userId}
     * @allow (get) If the user is the owner or a global admin.
     * @deny (get) If the user is not authenticated or not the owner/admin.
     * @allow (create) If the authenticated user's ID matches the document ID.
     * @deny (create) If the authenticated user's ID does not match the document ID.
     * @allow (update) If the user is the owner or a global admin, and the userId field is immutable.
     * @deny (update) If the user is not authenticated or not the owner/admin, or if the userId field is changed.
     * @allow (delete) If the user is a global admin and the document exists.
     * @deny (delete) If the user is not a global admin or the document does not exist.
     * @principle Enforces document ownership for user profiles and restricts write access.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if false; // Listing users is not permitted via these rules. Collection group queries should be used from the client instead.
      allow create: if isSignedIn() && isSelfCreate(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && isAdmin() && exists(/databases/$(database)/documents/users/$(userId));
    }

    /**
     * @description Secure attendance records under each user's profile.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (get) If the user is the owner or a global admin.
     * @deny (get) If the user is not authenticated or not the owner/admin.
     * @allow (create) If the user is the owner, and the userId field matches the parent path.
     * @deny (create) If the user is not authenticated or not the owner, or if the userId field does not match.
     * @allow (update) If the user is the owner or a global admin, and the userId field is immutable.
     * @deny (update) If the user is not authenticated or not the owner/admin, or if the userId field is changed.
     * @allow (delete) If the user is the owner or a global admin, and the document exists.
     * @deny (delete) If the user is not authenticated or not the owner/admin, or if the document does not exist.
     * @principle Enforces strict ownership for attendance records.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get, list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && exists(/databases/$(database)/documents/users/$(userId)/attendanceRecords/$(attendanceRecordId));
    }

    /**
     * @description Grants global admin privileges based on document existence in this collection.
     * @path /roles_admin/{userId}
     * @allow (get) If the user is a global admin or the owner.
     * @deny (get) If the user is not authenticated.
     * @allow (create) If the user is a global admin.
     * @deny (create) If the user is not authenticated.
     * @allow (update) If the user is a global admin and the document exists.
     * @deny (update) If the user is not authenticated or the document does not exist.
     * @allow (delete) If the user is a global admin and the document exists.
     * @deny (delete) If the user is not a global admin or the document does not exist.
     * @principle Grants global admin based on document existence.
     */
    match /roles_admin/{userId} {
      allow get, list: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && exists(/databases/$(database)/documents/roles_admin/$(userId));
      allow delete: if isSignedIn() && isAdmin() && exists(/databases/$(database)/documents/roles_admin/$(userId));
    }

    // ---- Helper Functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is creating their own user document.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the user is creating their own document, false otherwise.
     */
    function isSelfCreate(userId) {
        return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is a global administrator by verifying the existence of a document in the /roles_admin collection.
     * @return {boolean} True if the user is a global administrator, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Checks if the userId field in the document is immutable during an update.
     * @param {string} userId The user ID to check against.
     * @return {boolean} True if the userId field is immutable, false otherwise.
     */
    function isUserIdImmutable(userId) {
        return request.resource.data.id == resource.data.id;
    }

     /**
      * @description Checks if the userId field in the attendance record document is immutable during an update.
      * @param {string} userId The user ID to check against.
      * @return {boolean} True if the userId field is immutable, false otherwise.
      */
    function isUserIdAttendanceRecordImmutable(userId) {
        return request.resource.data.userId == resource.data.userId;
    }
  }
}