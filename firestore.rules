/**
 * @file Firebase Security Rules for AttendWise
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for private user data and utilizes global admin roles.
 *  It focuses on preventing unauthorized data access and modification.
 * @data_structure
 * - /companies/{companyId}: Stores company data.
 * - /users/{userId}: Stores user data, including a denormalized `companyId` for efficient authorization.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records for each user.
 * - /roles_admin/{userId}: Presence of a document indicates global admin privileges for the user.
 * @key_security_decisions
 * - User listing is restricted to prevent unauthorized data exposure.
 * - Global admin roles are managed through document existence in the `/roles_admin` collection.
 * - Data validation is limited to ownership and relational integrity checks for rapid prototyping.
 * @denormalization
 * - The `companyId` is denormalized into the `/users/{userId}` document to avoid costly `get()` operations when validating user access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to company documents.
     * @path /companies/{companyId}
     * @allow (read) Allow anyone to read company information.
     * @allow (create) Allow anyone to create a company document.
     * @allow (update) Deny anyone to update a company document.
     * @allow (delete) Deny anyone to delete a company document.
     * @deny (create) if the company id does not match the document id
     * @deny (update) if the company id does not match the document id
     * @deny (delete) if the company id does not match the document id
     * @principle Public read with owner-only writes.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if request.resource.data.id == companyId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to user documents.
     * @path /users/{userId}
     * @allow (create) Allow a user to create their own profile. The user ID in the path must match the user ID in the document.
     * @allow (get, list) Allow a user to read their own profile information.
     * @allow (update, delete) Only the user themselves or a global admin can update or delete their profile.
     * @deny (create) if the user id in the path does not match the user ID in the document.
     * @deny (update) if the user id in the path does not match the user ID in the document.
     * @deny (delete) if the user id in the path does not match the user ID in the document.
     * @principle Enforces user-ownership and admin override.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && (isOwner(userId) || isAdmin());
      allow delete: if isExistingOwner(userId) && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Controls access to attendance records for a specific user.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (create, get, list) Allow the user to create, read, and list their own attendance records.
     * @allow (update, delete) Only the user themselves or a global admin can update or delete their attendance records.
     * @deny (create) if the user id does not match the attendance records.
     * @deny (update) if the user id does not match the attendance records.
     * @deny (delete) if the user id does not match the attendance records.
     * @principle Enforces user-ownership for attendance records, with admin override.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && (isOwner(userId) || isAdmin());
      allow delete: if isExistingOwner(userId) && (isOwner(userId) || isAdmin());
    }

    /**
     * @description Controls access to global admin roles. Document existence grants admin privileges.
     * @path /roles_admin/{userId}
     * @allow (create) Anyone can request admin access by creating a document with their ID. This should ideally be restricted to a backend function or secured admin panel.
     * @allow (get, list) Anyone can check if a user has admin privileges by reading their document. Consider restricting `list` for security.
     * @allow (update, delete) Only a backend function can update or delete these role documents.
     * @deny (update) if the user tries to update the admin access
     * @deny (delete) if the user tries to delete the admin access
     * @principle Document existence determines admin privileges.
     */
    match /roles_admin/{userId} {
      allow get, list: if true;
      allow create: if true; // TODO: Restrict to backend or admin panel
      allow update: if false;
      allow delete: if false; // TODO: Restrict to backend or admin panel
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && resource != null;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}