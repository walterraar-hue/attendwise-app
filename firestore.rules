rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user owns the existing document.
     */
    function isExistingOwner(userId) {
        return isOwner(userId);
    }

    /**
     * @description Checks if the authenticated user is a global administrator by verifying the existence
     *              of a document in the /roles_admin/{userId} collection.
     */
    function isGlobalAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /companies/{companyId} collection.
     * @path /companies/{companyId}
     * @allow (get) If the user is a global admin.
     * @deny (create) Always deny non-admin users from creating company records.
     * @principle Restricts company data access to global admins only.
     */
    match /companies/{companyId} {
      allow get: if isGlobalAdmin();
      allow list: if false; // Listing companies is not allowed.
      allow create: if false; // Companies are not created by users.
      allow update: if isGlobalAdmin();
      allow delete: if isGlobalAdmin();
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) If the user is creating their own account (self-registration).
     * @allow (get) If the user is accessing their own account or is a global admin.
     * @deny (update) If the user is not the owner and not a global admin.
     * @principle Enforces user-ownership for user accounts, allowing self-registration and admin access.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isGlobalAdmin();
      allow list: if false; // Listing users is not allowed.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId) || isGlobalAdmin();
      allow delete: if isGlobalAdmin();
    }

    /**
     * @description Rules for the /users/{userId}/attendanceRecords/{attendanceRecordId} collection.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (create) If the user is creating an attendance record for themselves.
     * @allow (get) If the user is accessing their own attendance record or is a global admin.
     * @deny (update) If the user is not the owner and not a global admin.
     * @principle Enforces user-ownership for attendance records, restricting access to the user and global admins.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get: if isOwner(userId) || isGlobalAdmin();
      allow list: if isOwner(userId) || isGlobalAdmin();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId) || isGlobalAdmin();
      allow delete: if isGlobalAdmin();
    }

        /**
         * @description Rules for the /roles_admin/{userId} collection.
         * @path /roles_admin/{userId}
         * @allow (get) If the document exists (used by isGlobalAdmin()).
         * @deny (create)  Deny any client-side creation.  Admins must be provisioned server-side.
         *
         * @principle Only allow server-side provisioning of admin roles.
         */
        match /roles_admin/{userId} {
          allow get: if true; // Used by the isGlobalAdmin() helper function.
          allow list: if false;
          allow create: if false;
          allow update: if false;
          allow delete: if false;
        }
  }
}