/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for personal data and a company-based model for shared data. Global administrator privileges are granted based on document existence in a dedicated collection.
 *
 * Data Structure:
 * - /companies/{companyId}: Stores company information, accessible only to global admins.
 * - /users/{userId}: Stores user information, accessible only to the user and global admins. Contains denormalized companyId for authorization.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records, accessible only to the owning user.
 * - /roles_admin/{userId}: Indicates a global admin. Document existence grants admin privileges.
 *
 * Key Security Decisions:
 * - Users can only manage their own data (create, update, delete) under their user ID.
 * - Listing of user documents is disallowed to prevent information disclosure.
 * - Global admins have full access to all companies and users.
 * - Data validation is relaxed to allow for rapid prototyping, focusing on ownership and relationship integrity.
 *
 * Denormalization for Authorization:
 * - The `companyId` is denormalized into the `/users/{userId}` document to enable efficient company-based authorization without additional `get()` calls.
 * - Global admin privileges are determined by the existence of a document in `/roles_admin/{userId}`, avoiding the need for custom claims.
 *
 * Structural Segregation:
 * - Global admin roles are managed in a dedicated `/roles_admin` collection to simplify role-based access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to company documents. Only global admins can create, update, or delete company records.
     * @path /companies/{companyId}
     * @allow (create) - A global admin can create a company.
     * @deny (create) - A regular user cannot create a company.
     * @allow (get, list) -  Everyone can read company information.
     * @deny (update, delete) - A regular user cannot update or delete a company.
     * @principle Enforces admin-only access for company data.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Grants access to user documents. Users can create their own document and modify it. Global admins can modify any user document.
     * @path /users/{userId}
     * @allow (create) - A user can create their own user document.
     * @deny (create) - A user cannot create a user document with a mismatched user ID.
     * @allow (get) - A user can get their own user document.
     * @deny (get) - A user cannot get another user's document.
     * @allow (update, delete) - A user can update/delete their own user document. Global admins can always update/delete user documents.
     * @deny (update, delete) - A user cannot update/delete another user's document.
     * @principle Enforces document ownership and admin override for user data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if (isOwner(userId) && isExistingOwner(userId) && request.resource.data.id == resource.data.id) || (isAdmin() && resource != null);
      allow delete: if (isOwner(userId) && isExistingOwner(userId)) || (isAdmin() && resource != null);
    }

    /**
     * @description Grants access to attendance records for a specific user. Only the owning user can manage their attendance records.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (create) - A user can create attendance records under their own user ID.
     * @deny (create) - A user cannot create attendance records under another user's ID.
     * @allow (get, list) - A user can access attendance records under their own user ID.
     * @deny (get, list) - A user cannot access attendance records under another user's ID.
     * @allow (update, delete) - A user can update/delete their own attendance records.
     * @deny (update, delete) - A user cannot update/delete another user's attendance records.
     * @principle Enforces strict ownership for attendance record management.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId) && isExistingOwner(userId);
    }

     /**
      * @description Grants global administrator privileges based on document existence. Allows anyone to create the admin document if they are authenticated, but only allows an existing admin or the user themselves to update or delete it
      * @path /roles_admin/{userId}
      * @allow (create) - If a user exists
      * @deny (create) - If a user does not exist
      * @allow (get) - Anyone can read if a user is admin
      * @deny (get) - If a user does not exist
      * @allow (update, delete) - Only an existing admin or the user themselves can update or delete it
      * @deny (update, delete) - If a non-admin user attempts to update/delete it.
      * @principle Enforces existence-based global admin privileges.
      */
    match /roles_admin/{userId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if (isAdmin() && resource != null) || (isOwner(userId) && resource != null);
      allow delete: if (isAdmin() && resource != null) || (isOwner(userId) && resource != null);
    }


    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}