/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for attendance records and user data,
 * with company-level access control. It leverages denormalization of `companyId` in the `/users/{userId}`
 * collection to improve rule performance and authorization independence.  Global administrator privileges
 * are granted based on the existence of a document in the `/roles_admin/{userId}` collection.
 *
 * Data Structure:
 * - /companies/{companyId}: Stores company profiles. No direct user-level restrictions on reads.
 * - /users/{userId}: Stores user profiles, containing a denormalized `companyId` field.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records for each user.
 * - /roles_admin/{userId}: Indicates global administrator status.
 *
 * Key Security Decisions:
 * - Users can only manage their own attendance records.
 * - Users can only read their own user profile.
 * - Company data is accessible to all authenticated users.
 * - Global admin privileges are granted by document existence in `/roles_admin/{userId}`.
 * - Data validation is relaxed in this prototyping phase, except for critical ownership checks.
 *
 * Denormalization for Authorization:
 * - The `companyId` field is denormalized into the `/users/{userId}` document, enabling rules to
 *   validate user roles and company associations without requiring additional `get()` operations.
 *
 * Structural Segregation:
 * - Global admin roles are managed in a separate `/roles_admin/{userId}` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read access to company profiles for all authenticated users. Write access is denied.
     * @path /companies/{companyId}
     * @allow (get, list): if isSignedIn()
     * @deny (create, update, delete): if true
     * @principle Public read, owner-only writes
     */
    match /companies/{companyId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // No writes allowed at company level
    }

    /**
     * @description Enforces user-ownership for user profiles.  A user can read their own profile,
     * create their profile with a matching user ID, and update their profile.  Writes are restricted to the owner.
     * @path /users/{userId}
     * @allow (get, list): if isOwner(userId)
     * @allow (create): if isOwner(userId)
     * @allow (update, delete): if isExistingOwner(userId)
     * @deny create: if !isValidNewUser(userId);
     * @deny update: if !isUnchangedUserId(userId);
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidNewUser(userId);
      allow update: if isExistingOwner(userId) && isUnchangedUserId(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces user-ownership for attendance records. A user can manage their own records.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (get, list): if isOwner(userId)
     * @allow (create): if isOwner(userId)
     * @allow (update, delete): if isExistingOwner(userId)
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants global admin privileges based on document existence. An admin user can bypass
     * standard ownership checks. Only admins can create/delete admin privileges
     * @path /roles_admin/{userId}
     * @allow get, list: if false; // Prevent listing all admins
     * @allow create: if isAdmin();
     * @allow update: if false;
     * @allow delete: if isAdmin();
     * @principle Grants elevated privileges based on document existence.
     */
    match /roles_admin/{userId} {
      allow get, list: if false; // Prevent listing all admins
      allow create: if isAdmin();
      allow update: if false; // No updates allowed on roles_admin
      allow delete: if isAdmin();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
    }

    function isAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    
    function isValidNewUser(userId) {
        return request.resource.data.id == userId && request.auth.uid == userId;
    }
    
    function isUnchangedUserId(userId) {
        return request.resource.data.id == resource.data.id && request.auth.uid == userId;
    }
  }
}