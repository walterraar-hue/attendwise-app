/**
 * @fileoverview Firestore Security Rules for AttendWise application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data (attendance records).
 * Company data is generally accessible, but modifications are restricted.
 * Global administrator privileges are granted based on document existence in a dedicated collection.
 *
 * Data Structure:
 * - /companies/{companyId}: Stores company profiles.
 * - /users/{userId}: Stores user profiles, including a denormalized companyId.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records for each user.
 * - /roles_admin/{userId}: Presence of a document indicates global admin privileges.
 *
 * Key Security Decisions:
 * - User listing within a company is not directly supported by these rules, instead a collection group query on `/users` filtered by `companyId` should be used or a subcollection under `/companies/{companyId}/users/{userId}` should be used.
 * - Global admin privileges are granted based on document existence in the `/roles_admin/{userId}` collection.
 * - Read access is generally open unless the document sits under a user path, because queries cannot be filters.
 *
 * Denormalization for Authorization:
 * - The `companyId` is denormalized into the `/users/{userId}` document to enable authorization checks without additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to company profiles.
     * @path /companies/{companyId}
     * @allow get, list: if true (Company data is considered public).
     * @allow create: if false; (Company creation is likely handled server-side.)
     * @allow update: if false; (Company updates are likely restricted.)
     * @allow delete: if false; (Company deletion is likely restricted.)
     * @principle Allows anyone to read company profiles, but restricts write access.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants access to user profiles.
     * @path /users/{userId}
     * @allow get, list: if true;
     * @allow create: if isOwner(userId); (Allows user self-creation.)
     * @allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id; (Enforces ownership and id immutability.)
     * @allow delete: if isExistingOwner(userId); (Enforces ownership.)
     * @principle Enforces document ownership for writes and validates relational integrity.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to attendance records for a specific user.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow get, list: if isOwner(userId); (Allows owner to list their own records.)
     * @allow create: if isOwner(userId); (Enforces ownership.)
     * @allow update: if isExistingOwner(userId); (Enforces ownership.)
     * @allow delete: if isExistingOwner(userId); (Enforces ownership.)
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants global admin privileges based on document existence.
     * @path /roles_admin/{userId}
     * @allow get, list: if false; (Admin list is likely restricted.)
     * @allow create: if false; (Admin creation is likely handled server-side.)
     * @allow update: if false; (Admin updates are likely restricted.)
     * @allow delete: if false; (Admin removal is likely handled server-side.)
     * @principle Grants admin privileges based on document existence.
     */
    match /roles_admin/{userId} {
      allow get, list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the request is made by a signed-in user.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId The user ID to compare with the request's auth UID.
     * @return {bool} True if the user ID matches the request's auth UID, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

        /**
     * @description Checks if the request is made by the owner of an existing resource.
     * @param {string} userId The user ID to compare with the resource's owner ID.
     * @return {bool} True if the user ID matches the resource's owner ID and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}