/**
 * @fileoverview Firestore Security Rules for AttendWise.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * and uses document existence in a dedicated collection to grant global admin privileges.
 * It also provides for company-level data access and control. Data validation is minimal
 * to allow for rapid prototyping.
 *
 * Data Structure:
 * - /companies/{companyId}: Stores company profiles.
 * - /users/{userId}: Stores user profiles, including a denormalized companyId.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records for each user.
 * - /roles_admin/{userId}:  Documents in this collection indicate a global admin user. Document ID is the user ID.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed except for the authenticated user themselves.
 * - Global admin status is determined by the presence of a document in the `/roles_admin/{userId}` collection.
 * - Read-only collections are not explicitly defined but could be implemented with `allow get, list: if true;` where appropriate.
 *
 * Denormalization for Authorization:
 * - The `companyId` is denormalized into the `/users/{userId}` collection to avoid needing to perform `get()` operations on the `/companies/{companyId}` document
 *   during security rule evaluation.  This allows simple, efficient authorization checks based solely on the user's document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows management of company profiles.
     * @path /companies/{companyId}
     * @allow if the user is a global admin.
     * @deny if the user is not a global admin.
     * @principle Grants global admins full control over company data.
     */
    match /companies/{companyId} {
      // Helper function to check if the user is a global admin.
      function isGlobalAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isGlobalAdmin();
      allow update: if isGlobalAdmin();
      allow delete: if isGlobalAdmin();
    }

    /**
     * @description Allows management of user profiles.
     * @path /users/{userId}
     * @allow (create) if the user is creating their own profile and the userId matches their auth.uid.
     * @allow (get, list) if the userId matches the authenticated user's ID.
     * @allow (update, delete) if the user is a global admin or the user is updating their own profile.
     * @deny any other operations.
     * @principle Enforces user-ownership for profile data and grants global admins override privileges.
     */
    match /users/{userId} {
      // Helper function to check if the user is the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is an existing owner of the document.
      function isExistingOwner() {
        return request.auth.uid == userId && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isGlobalAdmin() || (isExistingOwner()); //Enforce immutable id
      allow delete: if isGlobalAdmin() || isExistingOwner();
    }

    /**
     * @description Allows management of attendance records for a specific user.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (get, list) if the userId matches the authenticated user's ID.
     * @allow (create) if the userId matches the authenticated user's ID.
     * @allow (update, delete) if the user is a global admin or the user is updating/deleting their own records.
     * @deny any other operations.
     * @principle Enforces user-ownership for attendance records and grants global admins override privileges.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      // Helper function to check if the user is the owner of the parent user document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is an existing owner of the parent user document.
      function isExistingOwner() {
        return request.auth.uid == userId && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isGlobalAdmin() || isExistingOwner();
      allow delete: if isGlobalAdmin() || isExistingOwner();
    }

    /**
     * @description Allows checking and assignment of global administrator role.
     * @path /roles_admin/{userId}
     * @allow (get) everyone can check if a user is an admin.
     * @allow (create, update, delete) only existing global admins can modify this collection.
     * @deny any other operations.
     * @principle Enforces that only existing admins can manage admin privileges.
     */
    match /roles_admin/{userId} {

      // Helper function to check if the user is a global admin.
      function isGlobalAdmin() {
        return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
      }

      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isGlobalAdmin();
      allow update: if isGlobalAdmin();
      allow delete: if isGlobalAdmin();
    }
  }
}