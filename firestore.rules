/**
 * @file Firebase Security Rules for AttendWise
 *
 * @core_philosophy This ruleset enforces a strict ownership model for user data,
 *   company data, and attendance records.  Administrative privileges are granted
 *   based on document existence in a segregated 'roles_admin' collection. The design
 *   prioritizes authorization independence and avoids complex queries within rules.
 *
 * @data_structure
 *   - /companies/{companyId}: Stores company profiles.
 *   - /users/{userId}: Stores user profiles, including the denormalized `companyId`.
 *   - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records
 *     for individual users.
 *   - /roles_admin/{userId}: Indicates global administrator status. Document presence
 *     confers admin privileges.
 *
 * @key_security_decisions
 *   - User listing is generally disallowed to prevent data exposure. Specific listing
 *     requirements should be addressed through targeted collection group queries with
 *     appropriate security constraints.
 *   - Global admin roles are managed via document existence in the `/roles_admin` collection.
 *   - The rules explicitly deny any write operations with `if true` to prevent accidental
 *     exposure. All write operations must be guarded by an authorization check.
 *
 * @denormalization_for_authorization
 *   - The `companyId` is denormalized into the `/users/{userId}` documents. This avoids
 *     the need for `get()` calls to the `/companies/{companyId}` document when authorizing
 *     user-specific operations.
 *
 * @structural_segregation
 *   - Global admin roles are segregated into the `/roles_admin` collection to avoid
 *     mixing role data with user profile data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access control for companies.
     * @path /companies/{companyId}
     * @allow (create) Authenticated user can create a company document.
     * @deny (create) Unauthenticated user cannot create a company document.
     * @allow (get) Any user can read a company document.
     * @deny (update) Only the company itself can update a company document.
     * @principle Enforces company-level access control.
     */
    match /companies/{companyId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false; // TODO: Implement company ownership/admin check
    }

    /**
     * @description Allows access control for users.
     * @path /users/{userId}
     * @allow (create) User can create their own profile.
     * @deny (create) User cannot create another user's profile.
     * @allow (get) Any user can read a user document.
     * @deny (update) Only the user themselves can update their profile.
     * @principle Enforces user-level access control.
     */
    match /users/{userId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId; // TODO: Implement user deactivation/deletion process
    }

    /**
     * @description Allows access control for attendance records.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (create) User can create an attendance record for themselves.
     * @deny (create) User cannot create an attendance record for another user.
     * @allow (get) Any user can read an attendance record.
     * @deny (update) Only the user themselves can update their own attendance record.
     * @principle Enforces user-level ownership for attendance records.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId; // TODO: Review if updates/deletes are allowed
    }

    /**
     * @description Allows global admin to perform any operation.
     * @path /roles_admin/{userId}
     * @allow (create) Only the system can grant admin roles.
     * @deny (create) Regular users cannot grant themselves admin roles.
     * @allow (get) Only the system can read admin roles.
     * @deny (update) Regular users cannot change admin roles.
     * @principle Grants admin access based on document existence.
     */
    match /roles_admin/{userId} {
      allow get, list: if false; // Only the system can read this.
      allow create: if false; // Only the system can create this.
      allow update, delete: if false; // Prevent modifications
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}