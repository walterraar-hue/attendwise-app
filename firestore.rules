/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for attendance records and company-based access control for work centers.
 *
 * Data Structure:
 * - /companies/{companyId}: Stores company information.
 * - /companies/{companyId}/workCenters/{workCenterId}: Stores work centers for companies.
 * - /users/{userId}: Stores user information.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records for each user.
 *
 * Key Security Decisions:
 * - Users can only list and access their own attendance records.
 * - Users can only create their own user document, and cannot modify it after creation.
 * - Work centers are accessible to company members only.
 * - Listing of users collection is disallowed.
 *
 * Denormalization for Authorization:
 * - User documents include 'companyId' to simplify company-based access control for work centers.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to company documents based on the company ID.
     * @path /companies/{companyId}
     * @allow (get) Any authenticated user can read a company document.
     * @deny (create, update, delete) Only authenticated users can access company documents.
     * @principle Enforces company-level access control.
     */
    match /companies/{companyId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Allows access to work centers within a specific company.
     * @path /companies/{companyId}/workCenters/{workCenterId}
     * @allow (get, list) Any authenticated user can read or list work centers within a company.
     * @deny (create, update, delete) Only authenticated users can access work centers documents.
     * @principle Enforces company-level access control for work centers.
     */
    match /companies/{companyId}/workCenters/{workCenterId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Allows users to create their own user document, and restricts modifications.
     * @path /users/{userId}
     * @allow (create) Allows a user to create their own document if the user ID matches the authenticated user's ID.
     * @allow (get) Allows a user to read their own document if the user ID matches the authenticated user's ID.
     * @deny (list) Listing users is not allowed
     * @allow (update)  Allows the user to update their own document
     * @deny (delete)  Delete is disallowed
     * @principle Enforces user-ownership for user documents and prevents unauthorized modifications.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Allows users to manage their own attendance records.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (list) Allows a user to list their own attendance records if the user ID matches the authenticated user's ID.
     * @allow (create) Allows a user to create a new attendance record if the user ID matches the authenticated user's ID.
     * @allow (get) Allows a user to get their own attendance record if the user ID matches the authenticated user's ID.
     * @allow (update, delete) Allows the user to update or delete an existing attendance record they own.
     * @deny Requests that do not match the user ID.
     * @principle Enforces user-ownership for attendance records.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(userId) && resource.data.userId == request.resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's ID.
     * @param {string} userId The user ID to check.
     * @returns {boolean} True if the user ID matches the authenticated user's ID, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the existing document.
     *              This function combines the ownership check with the existence check,
     *              preventing accidental operations on non-existent documents.
     * @param {string} userId The user ID to check.
     * @returns {boolean} True if the user is the owner of the existing document, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}