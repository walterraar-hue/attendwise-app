/**
 * @fileoverview Firestore Security Rules for AttendWise.
 *
 * Core Philosophy: This ruleset enforces a strict user-ownership model for user-specific data,
 * with company-level data accessible to authorized users. Global administrator privileges are
 * granted based on document existence in a segregated collection. The rules are designed to
 * prevent unauthorized data access and modification, while allowing for flexible data shapes
 * during the prototyping phase.
 *
 * Data Structure:
 * - /companies/{companyId}: Stores company-wide information.
 * - /users/{userId}: Stores individual user information, including the denormalized 'companyId'.
 * - /users/{userId}/attendanceRecords/{attendanceRecordId}: Stores attendance records for each user.
 * - /roles_admin/{userId}: Documents in this collection grant global admin privileges to the user.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed to prevent unauthorized data exposure.
 * - The `companyId` is denormalized into the `/users/{userId}` collection to avoid `get()` calls
 *   when validating user roles and company associations.
 * - Global admin roles are managed via document existence in the `/roles_admin/{userId}` collection.
 * - Data shape validation is relaxed during prototyping to allow for rapid iteration, but
 *   authorization-critical fields are validated.
 * - No write operations ever use `if true;`.
 *
 * Denormalization for Authorization:
 * - The `companyId` is denormalized into the `/users/{userId}` documents. This allows security
 *   rules to validate user roles and company associations without needing to perform extra reads.
 *
 * Structural Segregation:
 * - Global admin roles are managed in the separate `/roles_admin/{userId}` collection. This
 *   segregation simplifies rule logic and improves performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to company documents.
     * @path /companies/{companyId}
     * @allow (read) Any signed-in user can read company data.
     * @allow (create, update, delete) Only a global admin can create, update, or delete company data.
     * @deny  (create, update, delete) Any non-admin user attempts to modify company data.
     * @principle Enforces admin-only write access to company data.
     */
    match /companies/{companyId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to user documents.
     * @path /users/{userId}
     * @allow (get, list) Only the user themselves (owner) can read their user data.
     * @allow (create) A user can create their own document if the ID matches their auth UID.
     * @allow (update, delete) Only the user themselves can update or delete their user data.
     * @deny (create) A user attempts to create a document with an ID that doesn't match their auth UID.
     * @deny (update, delete) A different user attempts to modify another user's data.
     * @principle Enforces document ownership for reads and writes, and validates user ID on creation.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSelfCreation(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to attendance records for a specific user.
     * @path /users/{userId}/attendanceRecords/{attendanceRecordId}
     * @allow (get, list) Only the user themselves (owner) can read their attendance records.
     * @allow (create) Only the user themselves can create attendance records.
     * @allow (update, delete) Only the user themselves can update or delete their attendance records.
     * @deny (create) A different user attempts to create attendance records for another user.
     * @deny (update, delete) A different user attempts to modify another user's attendance records.
     * @principle Enforces document ownership for attendance records, nested under the user document.
     */
    match /users/{userId}/attendanceRecords/{attendanceRecordId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Controls access to the roles_admin collection.
      * @path /roles_admin/{userId}
      * @allow (get) Any signed-in user can check if a user is an admin
      * @allow (create) Only a signed-in user, where the document ID matches the auth UID can create an admin user.
      * @allow (delete) Any signed-in user, where the document ID matches the auth UID can delete an admin user.
      * @allow (update) Not allowed
      * @deny   (create) Creation denied if the document ID does not match the auth UID
      * @principle Role based access to top level admin.
      */
    match /roles_admin/{userId} {
        allow get: if isSignedIn();
        allow create: if isSelfCreation(userId);
        allow update: if false;
        allow delete: if isSelfCreation(userId);
        allow list: if false;
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document, based on the userId.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     * @example isOwner('user123') returns true if request.auth.uid == 'user123'.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is creating their own document, and the ID matches their auth UID.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user is creating their own document, false otherwise.
     */
    function isSelfCreation(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the document (for update/delete).
     * @param {string} userId The user ID to compare against the resource data.
     * @return {boolean} True if the user is the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && existsAfter(resource);
    }

    /**
     * @description Prevents the user ID from being changed after creation.
     * @param {string} userId The user ID to compare against the resource data.
     * @return {boolean} True if the user ID is not changed, false otherwise.
     */
    function isUserIdNotChanged(userId) {
        return request.resource.data.keys().toSet().hasAll(resource.data.keys().toSet());
    }

    /**
     * @description Checks if the user is a global administrator based on document existence.
     * @return {boolean} True if the user has a document in the /roles_admin/{userId} collection.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}